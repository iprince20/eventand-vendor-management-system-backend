{
  "info": {
    "_postman_id": "a4e78482-04c2-4bd7-a2ac-4ee8f8e65baf",
    "name": "Event and Vendor Management System Mid-Term",
    "description": "Requests are named by requirement ID. Create parent data first and replace collection ID variables using IDs from the /all endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "A1 - Verify entities and relationships",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/service-types/all"
      }
    },
    {
      "name": "A2 - Save service type",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Catering\"\n}" },
        "url": "{{baseUrl}}/api/service-types/save"
      }
    },
    {
      "name": "A2 - Save stall",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"stallNumber\": 1,\n  \"name\": \"Stall 1\"\n}" },
        "url": "{{baseUrl}}/api/stalls/save"
      }
    },
    {
      "name": "A2 - Save vendor",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"vendorName\": \"Kigali Catering\",\n  \"contactPerson\": \"Alex\",\n  \"phone\": \"+250788000001\",\n  \"stall\": { \"id\": \"{{stallId}}\" },\n  \"serviceTypes\": [{ \"id\": \"{{serviceTypeId}}\" }]\n}" },
        "url": "{{baseUrl}}/api/vendors/save"
      }
    },
    {
      "name": "A2 - Save organizer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Aline\",\n  \"lastName\": \"Gatete\",\n  \"organizerCode\": \"ORG-021\",\n  \"phone\": \"+250788000002\",\n  \"email\": \"aline@example.com\"\n}" },
        "url": "{{baseUrl}}/api/organizers/save"
      }
    },
    {
      "name": "A2 - Save event booking",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"eventDate\": \"2026-11-15\",\n  \"eventName\": \"Autumn reception\",\n  \"guests\": 100,\n  \"status\": \"DECLINED\",\n  \"organizer\": { \"id\": \"{{organizerId}}\" },\n  \"vendor\": { \"id\": \"{{vendorId}}\" }\n}" },
        "url": "{{baseUrl}}/api/event-bookings/save"
      }
    },
    {
      "name": "A2 - List service types",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/service-types/all" }
    },
    {
      "name": "A2 - List stalls",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/stalls/all" }
    },
    {
      "name": "A2 - List vendors",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/vendors/all" }
    },
    {
      "name": "A2 - List organizers",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/organizers/all" }
    },
    {
      "name": "A2 - List event bookings",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/event-bookings/all" }
    },
    {
      "name": "A2 - Get service type",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/service-types/{{serviceTypeId}}" }
    },
    {
      "name": "A2 - Update service type",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Catering updated\"\n}" },
        "url": "{{baseUrl}}/api/service-types/update/{{serviceTypeId}}"
      }
    },
    {
      "name": "A2 - Delete service type",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/service-types/delete/{{serviceTypeId}}" }
    },
    {
